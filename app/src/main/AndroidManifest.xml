<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Screen time: read on-device app usage (user grants in system settings) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Quick info: show whether Wi-Fi or mobile data is connected -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Lets the user start an uninstall from the app list -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Package visibility: a launcher only needs to see launchable apps,
         so QUERY_ALL_PACKAGES (a restricted Play permission) is not required -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".LauncherApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.MinimalistLauncher"
        tools:targetApi="33">

        <!-- Main Launcher Activity -->
        <activity
            android:name=".ui.launcher.LauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustPan"
            android:theme="@style/Theme.MinimalistLauncher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- App List Activity -->
        <activity
            android:name=".ui.applist.AppListActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MinimalistLauncher" />

        <!-- Settings Activity -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:label="@string/settings"
            android:theme="@style/Theme.MinimalistLauncher" />

        <!-- Screen time report -->
        <activity
            android:name=".ui.usage.UsageActivity"
            android:exported="false"
            android:label="@string/usage_report"
            android:theme="@style/Theme.MinimalistLauncher" />

        <!-- Mindful pause before a distracting app -->
        <activity
            android:name=".ui.pause.PauseActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.MinimalistLauncher" />

        <!-- Lock-in focus timer -->
        <activity
            android:name=".ui.lockin.LockInActivity"
            android:exported="false"
            android:label="@string/lock_in"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MinimalistLauncher" />

        <!-- Weekly recap (shareable card) -->
        <activity
            android:name=".ui.recap.RecapActivity"
            android:exported="false"
            android:label="@string/recap_title"
            android:theme="@style/Theme.MinimalistLauncher" />

        <!-- Shares the recap image with other apps (read-only, on request) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Focus Mode Activity -->
        <activity
            android:name=".ui.focus.FocusModeActivity"
            android:exported="false"
            android:label="@string/focus_mode"
            android:theme="@style/Theme.MinimalistLauncher" />

    </application>

</manifest>
