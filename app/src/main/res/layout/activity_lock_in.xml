<?xml version="1.0" encoding="utf-8"?>
<!-- Lock-in focus timer: set-up state and running-session state -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/app_bar_height"
        app:navigationContentDescription="@string/navigate_up"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/lock_in" />

    <!-- Set-up -->
    <LinearLayout
        android:id="@+id/setup_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/setup_headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/lock_in_headline"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/setup_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/lock_in_caption"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/label_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="@string/lock_in_label_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLength="60"
            android:minHeight="@dimen/touch_target_min" />

        <TextView
            android:id="@+id/duration_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/lock_in_duration"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/duration_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/apps_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/lock_in_allowed_apps"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/apps_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="52dp"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textSize="15sp"
            tools:text="Phone, Messages, Spotify · Change" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/start_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/lock_in_start"
            android:textSize="17sp" />
    </LinearLayout>

    <!-- Running session -->
    <LinearLayout
        android:id="@+id/session_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp"
        android:visibility="gone">

        <com.minimalist.launcher.ui.launcher.GoalRingView
            android:id="@+id/session_ring"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_marginTop="40dp" />

        <TextView
            android:id="@+id/session_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:textSize="20sp"
            tools:text="Revise chapter 4" />

        <TextView
            android:id="@+id/session_apps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textSize="14sp"
            tools:text="Only Phone, Spotify and Notion work until the timer ends" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/end_button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/lock_in_hold_to_end"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
