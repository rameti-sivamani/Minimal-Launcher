<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/app_bar_height"
            app:title="@string/settings"
            app:navigationContentDescription="@string/navigate_up"
            app:navigationIcon="?attr/homeAsUpIndicator" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/settings_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/settings_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding_horizontal"
            android:paddingEnd="@dimen/screen_padding_horizontal"
            android:paddingTop="@dimen/spacing_medium"
            android:paddingBottom="@dimen/spacing_large">

            <TextView
                android:id="@+id/appearance_header"
                style="@style/SettingsHeader"
                android:layout_marginTop="@dimen/spacing_medium"
                android:text="@string/appearance" />

            <LinearLayout
                android:id="@+id/theme_setting"
                style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/theme" />

                <TextView
                    android:id="@+id/theme_summary"
                    style="@style/SettingsRowSummary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/font_size_setting"
                style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/font_size" />

                <TextView
                    android:id="@+id/font_size_summary"
                    style="@style/SettingsRowSummary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/show_icons_setting"
                style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/show_app_icons" />

                <TextView
                    android:id="@+id/show_icons_summary"
                    style="@style/SettingsRowSummary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/show_day_toggle"
                style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/show_day_of_week" />

                <TextView
                    android:id="@+id/show_day_status"
                    style="@style/SettingsRowSummary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/quick_info_toggle"
                style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/quick_info" />

                <TextView
                    android:id="@+id/quick_info_status"
                    style="@style/SettingsRowSummary" />
            </LinearLayout>

            <TextView
                android:id="@+id/usage_header"
                style="@style/SettingsHeader"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="@string/usage_awareness" />

            <LinearLayout
                android:id="@+id/show_screen_time_setting"
                style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/show_screen_time" />

                <TextView
                    android:id="@+id/show_screen_time_summary"
                    style="@style/SettingsRowSummary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/usage_access_setting"
                style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/usage_access_title" />

                <TextView
                    android:id="@+id/usage_access_summary"
                    style="@style/SettingsRowSummary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/warnings_setting"
                style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/enable_launch_warnings" />

                <TextView
                    android:id="@+id/warnings_summary"
                    style="@style/SettingsRowSummary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/threshold_setting"
                style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/launch_warning_threshold" />

                <TextView
                    android:id="@+id/threshold_summary"
                    style="@style/SettingsRowSummary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/focus_modes_setting"
                style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/focus_modes" />

                <TextView
                    android:id="@+id/focus_modes_summary"
                    style="@style/SettingsRowSummary" />
            </LinearLayout>

            <TextView
                android:id="@+id/apps_header"
                style="@style/SettingsHeader"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="@string/apps" />

            <LinearLayout
                android:id="@+id/app_sorting_setting"
                style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/app_sorting" />

                <TextView
                    android:id="@+id/app_sorting_summary"
                    style="@style/SettingsRowSummary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hidden_apps_setting"
                style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/hidden_apps" />

                <TextView
                    android:id="@+id/hidden_apps_summary"
                    style="@style/SettingsRowSummary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/reset_favorites_setting"
                style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/reset_favorites" />

                <TextView
                    android:id="@+id/reset_favorites_summary"
                    style="@style/SettingsRowSummary" />
            </LinearLayout>

            <TextView
                android:id="@+id/system_header"
                style="@style/SettingsHeader"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="@string/system" />

            <LinearLayout
                android:id="@+id/set_default_launcher"
                style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/set_as_default" />

                <TextView
                    android:id="@+id/default_launcher_summary"
                    style="@style/SettingsRowSummary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/privacy_policy_setting"
                style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/privacy_policy" />

                <TextView
                    android:id="@+id/privacy_policy_summary"
                    style="@style/SettingsRowSummary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/version_setting"
                style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/version" />

                <TextView
                    android:id="@+id/version_summary"
                    style="@style/SettingsRowSummary" />
            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
