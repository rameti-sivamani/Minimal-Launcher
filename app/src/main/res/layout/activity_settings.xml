<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false">

    <!-- App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/app_bar_height"
            app:title="Settings"
            app:navigationIcon="?attr/homeAsUpIndicator" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Settings Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/settings_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/settings_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding_horizontal"
            android:paddingEnd="@dimen/screen_padding_horizontal"
            android:paddingTop="@dimen/spacing_medium"
            android:paddingBottom="@dimen/spacing_large">

            <!-- Appearance Section Header -->
            <TextView
                android:id="@+id/appearance_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Appearance"
                android:textSize="@dimen/text_size_secondary"
                android:textStyle="bold"
                android:layout_marginTop="@dimen/spacing_medium"
                android:layout_marginBottom="@dimen/spacing_tiny" />

            <!-- Theme Setting -->
            <LinearLayout
                android:id="@+id/theme_setting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/list_item_height_two_line"
                android:paddingStart="@dimen/list_item_padding_horizontal"
                android:paddingEnd="@dimen/list_item_padding_horizontal"
                android:paddingTop="@dimen/list_item_padding_vertical"
                android:paddingBottom="@dimen/list_item_padding_vertical"
                android:background="?attr/selectableItemBackground"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/theme_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Theme"
                    android:textSize="@dimen/text_size_body"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/theme_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OLED Black"
                    android:textSize="@dimen/text_size_secondary"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="@dimen/spacing_micro" />
            </LinearLayout>

            <!-- Font Size Setting -->
            <LinearLayout
                android:id="@+id/font_size_setting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/list_item_height_two_line"
                android:paddingStart="@dimen/list_item_padding_horizontal"
                android:paddingEnd="@dimen/list_item_padding_horizontal"
                android:paddingTop="@dimen/list_item_padding_vertical"
                android:paddingBottom="@dimen/list_item_padding_vertical"
                android:background="?attr/selectableItemBackground"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/font_size_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Font Size"
                    android:textSize="@dimen/text_size_body"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/font_size_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Medium"
                    android:textSize="@dimen/text_size_secondary"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="@dimen/spacing_micro" />
            </LinearLayout>

            <!-- Quick Info Toggle -->
            <LinearLayout
                android:id="@+id/quick_info_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/list_item_height_two_line"
                android:paddingStart="@dimen/list_item_padding_horizontal"
                android:paddingEnd="@dimen/list_item_padding_horizontal"
                android:paddingTop="@dimen/list_item_padding_vertical"
                android:paddingBottom="@dimen/list_item_padding_vertical"
                android:background="?attr/selectableItemBackground"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/quick_info_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Quick Info"
                    android:textSize="@dimen/text_size_body"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/quick_info_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hidden"
                    android:textSize="@dimen/text_size_secondary"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- Show Day of Week Toggle -->
            <LinearLayout
                android:id="@+id/show_day_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/list_item_height_two_line"
                android:paddingStart="@dimen/list_item_padding_horizontal"
                android:paddingEnd="@dimen/list_item_padding_horizontal"
                android:paddingTop="@dimen/list_item_padding_vertical"
                android:paddingBottom="@dimen/list_item_padding_vertical"
                android:background="?attr/selectableItemBackground"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/show_day_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Show Day of Week"
                    android:textSize="@dimen/text_size_body" />

                <TextView
                    android:id="@+id/show_day_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Yes"
                    android:textSize="@dimen/text_size_secondary" />
            </LinearLayout>

            <!-- Apps Section Header -->
            <TextView
                android:id="@+id/apps_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apps"
                android:textSize="@dimen/text_size_secondary"
                android:textStyle="bold"
                android:layout_marginTop="@dimen/spacing_large"
                android:layout_marginBottom="@dimen/spacing_tiny" />

            <!-- App Sorting -->
            <LinearLayout
                android:id="@+id/app_sorting_setting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/list_item_height_two_line"
                android:paddingStart="@dimen/list_item_padding_horizontal"
                android:paddingEnd="@dimen/list_item_padding_horizontal"
                android:paddingTop="@dimen/list_item_padding_vertical"
                android:paddingBottom="@dimen/list_item_padding_vertical"
                android:background="?attr/selectableItemBackground"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/app_sorting_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="App Sorting"
                    android:textSize="@dimen/text_size_body"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/app_sorting_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alphabetical"
                    android:textSize="@dimen/text_size_secondary"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="@dimen/spacing_micro" />
            </LinearLayout>

            <!-- Hidden Apps -->
            <LinearLayout
                android:id="@+id/hidden_apps_setting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/list_item_height_two_line"
                android:paddingStart="@dimen/list_item_padding_horizontal"
                android:paddingEnd="@dimen/list_item_padding_horizontal"
                android:paddingTop="@dimen/list_item_padding_vertical"
                android:paddingBottom="@dimen/list_item_padding_vertical"
                android:background="?attr/selectableItemBackground"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/hidden_apps_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hidden Apps"
                    android:textSize="@dimen/text_size_body"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/hidden_apps_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 apps hidden"
                    android:textSize="@dimen/text_size_secondary"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="@dimen/spacing_micro" />
            </LinearLayout>

            <!-- Set as Default Launcher -->
            <LinearLayout
                android:id="@+id/set_default_launcher"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/list_item_height_two_line"
                android:paddingStart="@dimen/list_item_padding_horizontal"
                android:paddingEnd="@dimen/list_item_padding_horizontal"
                android:paddingTop="@dimen/list_item_padding_vertical"
                android:paddingBottom="@dimen/list_item_padding_vertical"
                android:background="?attr/selectableItemBackground"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Set as Default Launcher"
                    android:textSize="@dimen/text_size_body"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Make this your home screen"
                    android:textSize="@dimen/text_size_secondary"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="@dimen/spacing_micro" />
            </LinearLayout>

            <!-- System Section Header -->
            <TextView
                android:id="@+id/system_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System"
                android:textSize="@dimen/text_size_secondary"
                android:textStyle="bold"
                android:layout_marginTop="@dimen/spacing_large"
                android:layout_marginBottom="@dimen/spacing_tiny" />

            <!-- Reset Favorites -->
            <LinearLayout
                android:id="@+id/reset_favorites_setting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/list_item_height_two_line"
                android:paddingStart="@dimen/list_item_padding_horizontal"
                android:paddingEnd="@dimen/list_item_padding_horizontal"
                android:paddingTop="@dimen/list_item_padding_vertical"
                android:paddingBottom="@dimen/list_item_padding_vertical"
                android:background="?attr/selectableItemBackground"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reset Favorites"
                    android:textSize="@dimen/text_size_body"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Remove all favorite apps"
                    android:textSize="@dimen/text_size_secondary"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="@dimen/spacing_micro" />
            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
